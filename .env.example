# BarberPro AI Insights - environment variables
# Copy to .env.local (gitignored) and fill in real values. Never commit secrets.
#
# Local development: run `npx supabase start`, then `npx supabase status`
# and copy the API URL and the anon/publishable key below.

# --- Supabase (public: safe in the browser; all access is still enforced by RLS) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Optional: canonical site URL used in auth email links (no trailing slash).
# Must be on the Supabase Auth redirect allow-list. Defaults to the request host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never prefix with NEXT_PUBLIC_, never import in client code) ---
# The app does NOT use a Supabase service-role key. Do not add one here.

# OpenAI key for AI Insights (server-side only; used by POST /api/ai/insights).
# Without it, the dashboard shows "AI insights aren't available" and everything else works.
OPENAI_API_KEY=your-openai-api-key
# Optional: model id (defaults to gpt-5.4-mini).
# OPENAI_MODEL=gpt-5.4-mini
# Optional: OpenAI-compatible gateway/proxy base URL (defaults to https://api.openai.com/v1).
# OPENAI_BASE_URL=

# --- Integration tests (optional) ---
# If unset, tests read values from `npx supabase status -o env` automatically.
# Point these ONLY at a local or disposable test project, never production.
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_ANON_KEY=your-local-anon-key
